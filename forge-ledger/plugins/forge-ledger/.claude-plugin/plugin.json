{
  "name": "forge-ledger",
  "version": "0.1.0",
  "description": "작업 계획서 작성방식으로 프로젝트를 이끌고 Plane·Gitea·Penpot을 잇는 플러그인",
  "author": {
    "name": "forge"
  },
  "userConfig": {
    "plane_url": {
      "type": "string",
      "required": true,
      "title": "Plane 주소",
      "description": "Plane 서버의 기본 URL"
    },
    "plane_workspace": {
      "type": "string",
      "default": "forge",
      "title": "Plane 워크스페이스",
      "description": "Plane 워크스페이스 슬러그"
    },
    "plane_api_key": {
      "type": "string",
      "required": true,
      "sensitive": true,
      "title": "Plane API 키",
      "description": "Plane API 인증 키"
    },
    "plane_mcp_url": {
      "type": "string",
      "required": true,
      "title": "Plane MCP 주소",
      "description": "Plane MCP 엔드포인트 URL (/http/api-key/mcp로 끝남)"
    },
    "gitea_url": {
      "type": "string",
      "required": true,
      "title": "Gitea 주소",
      "description": "Gitea 서버의 기본 URL"
    },
    "gitea_token": {
      "type": "string",
      "required": true,
      "sensitive": true,
      "title": "Gitea 토큰",
      "description": "허브 대조에 쓰는 Gitea 개인 액세스 토큰"
    },
    "dashboard_bind": {
      "type": "string",
      "default": "127.0.0.1",
      "title": "대시보드 바인드 주소",
      "description": "로컬 대시보드 서버가 연결을 받을 주소"
    },
    "worklog_project_key": {
      "type": "string",
      "default": "WLOG",
      "title": "작업 일지 프로젝트 키",
      "description": "작업 일지를 저장할 Plane 프로젝트 키"
    },
    "worklog_host_label": {
      "type": "string",
      "default": "",
      "title": "작업 일지 호스트 이름",
      "description": "작업 기록에 표시할 컴퓨터 이름"
    },
    "worklog_auto": {
      "type": "boolean",
      "default": true,
      "title": "작업 일지 자동 기록",
      "description": "작업 일지 자동 기록 사용"
    }
  }
}
