#!/bin/sh
# Thin product frontdoor. Python selection and package imports live in pmt_easy.py.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 3
entry="$root/scripts/pmt_easy.py"

if [ -n "${PMT_PYTHON:-}" ]; then
    exec "$PMT_PYTHON" -B "$entry" "$@"
fi
if command -v python >/dev/null 2>&1; then
    exec python -B "$entry" "$@"
fi
if command -v python3 >/dev/null 2>&1; then
    exec python3 -B "$entry" "$@"
fi
if command -v py >/dev/null 2>&1; then
    exec py -3 -B "$entry" "$@"
fi
echo "PMT needs Python 3.13 or later. Finish setup, then retry." >&2
exit 3
