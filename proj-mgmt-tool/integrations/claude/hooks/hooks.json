{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "${user_config.python_path}", "args": ["${CLAUDE_PLUGIN_ROOT}/integrations/claude/hook.py", "--event", "SessionStart", "--with-context"], "timeout": 2 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "${user_config.python_path}", "args": ["${CLAUDE_PLUGIN_ROOT}/integrations/claude/hook.py", "--event", "UserPromptSubmit"], "timeout": 2 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "${user_config.python_path}", "args": ["${CLAUDE_PLUGIN_ROOT}/integrations/claude/hook.py", "--event", "Stop"], "timeout": 2 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "${user_config.python_path}", "args": ["${CLAUDE_PLUGIN_ROOT}/integrations/claude/hook.py", "--event", "SessionEnd"], "timeout": 2 }] }]
  }
}
